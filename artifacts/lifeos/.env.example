# LifeOS Frontend Environment Variables
PORT=3000
BASE_PATH=/

# Clerk Publishable Key (From https://dashboard.clerk.com -> API Keys)
# Must match the same publishable key as api-server
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Target URL for API proxy (defaults to http://localhost:5000)
API_SERVER_URL=http://localhost:5000

# VAPID Public Key for Web Push notifications (Must match VAPID_PUBLIC_KEY in api-server)
VITE_VAPID_PUBLIC_KEY=
