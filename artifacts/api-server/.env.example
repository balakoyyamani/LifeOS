# LifeOS API Server Environment Variables
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (local PostgreSQL or cloud provider e.g. Neon.tech, Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/lifeos

# Clerk Authentication Keys (From https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
