# ==============================================================================
# LifeOS Production Environment Blueprint
# Copy this file to .env in your production environment (Railway, Render, AWS, etc.)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 1. Clerk Production Authentication Keys
# Obtain from https://dashboard.clerk.com -> Your App -> Production Instance -> API Keys
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_PRODUCTION_SECRET_KEY

# Frontend Vite client key (matches CLERK_PUBLISHABLE_KEY for frontend bundling)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Connection Pooler (Port 6543)
# Obtain from https://supabase.com/dashboard -> Project Settings -> Database -> Connection Pooling
# Mode: Transaction (Port 6543) with SSL enabled
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# Database pool tuning (defaults: max=10, connectionTimeout=5000ms, idleTimeout=30000ms)
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins
# Comma-separated list of domains permitted to send credentialed requests to /api
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ------------------------------------------------------------------------------
# 4. Optional Custom Static Assets Directory
# If deploying as a single unified container, api-server automatically discovers
# the frontend at artifacts/lifeos/dist/public. Override here if needed:
# ------------------------------------------------------------------------------
# STATIC_DIR=/app/artifacts/lifeos/dist/public
